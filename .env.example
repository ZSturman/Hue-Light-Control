# Copy to .env and fill in. .env is git-ignored.

# 2.4 GHz network only (ESP32 has no 5 GHz radio).
WIFI_SSID=YourNetwork
WIFI_PASSWORD=YourPassword

# Optional: leave blank and the device will search for the bridge.
# Best practice: reserve this IP for the bridge in your router.
HUE_BRIDGE_IP=192.168.1.50

# Created by pressing the bridge link button, then POSTing
# {"devicetype":"hue_light_control#esp32"} to https://<bridge-ip>/api
HUE_USERNAME=your-hue-application-key

# Room/zone to control. List them at https://<bridge-ip>/api/<username>/groups
HUE_GROUP_ID=1
HUE_GROUP_NAME=Living room

# Not currently used by the firmware.
HUE_LIGHT_ID=
HUE_LIGHT_NAME=
